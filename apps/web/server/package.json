{
  "name": "@novel-studio/web-server",
  "version": "0.3.0-alpha.0",
  "description": "Novel Studio Web Studio — local-first backend (Hono). Read-only API over @novel/core for M1; build/SSE endpoints land in later milestones. See docs/design/05-web-studio.md.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "novel-web": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@novel/core": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
