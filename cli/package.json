{
  "name": "@novel-studio/cli",
  "version": "0.2.0-alpha.3",
  "description": "Novel Studio CLI — AI-powered Chinese web novel writing pipeline. v2 alpha-2b: + character-atelier (protagonist / antagonists / supporting + relationships); alpha-2c: + outline-architect (master / volume / chapter 三级大纲).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "novel": "./dist/bin/novel.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/post-build.mjs",
    "dev": "tsx src/bin/novel.ts",
    "novel": "tsx src/bin/novel.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@inquirer/prompts": "^7.2.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "nanoid": "^5.0.9",
    "openai": "^4.73.1",
    "ora": "^8.1.1",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
